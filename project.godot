config_version=5

[application]

config/name="Nuevo Proyecto de Juego"
run/main_scene="res://scenes/tutorial/first_encounter.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

