[gd_resource type="Resource" script_class="DialogueData" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry_data.gd" id="2_entry"]

[sub_resource type="Resource" id="Entry1"]
script = ExtResource("2_entry")
speaker = "{player_name}"
text = "La tierra está abierta hacia el refugio. Una empalizada aquí desviaría a los atacantes hacia el paso estrecho."
side = "left"

[resource]
script = ExtResource("1_data")
dialogue_id = &"investigation_fortify"
entries = Array[ExtResource("2_entry")]([SubResource("Entry1")])

