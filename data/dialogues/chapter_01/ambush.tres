[gd_resource type="Resource" script_class="DialogueData" format=3 uid="uid://closny2jrtpwp"]

[ext_resource type="Script" uid="uid://cg3b2j5ksssfo" path="res://scripts/dialogue/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" uid="uid://v4j5d331l6nn" path="res://scripts/dialogue/dialogue_choice_data.gd" id="1_lv12k"]
[ext_resource type="Script" uid="uid://cyihtyybqw70d" path="res://scripts/dialogue/dialogue_entry_data.gd" id="2_entry"]

[sub_resource type="Resource" id="Entry1"]
script = ExtResource("2_entry")
speaker = "Goblin"
text = "¡Maldito humano asqueroso! Dejá la bolsa y todo lo que llevás... o te destripamos acá mismo."

[sub_resource type="Resource" id="Entry2"]
script = ExtResource("2_entry")
speaker = "{player_name}"
text = "Esta zona pertenece al asentamiento. Si quieren nuestros recursos, tendrán que quitármelos."
side = "left"

[sub_resource type="Resource" id="Entry3"]
script = ExtResource("2_entry")
speaker = "Goblin"
text = "Je. El cachorro cree que puede elegir. ¡Mátenlo!"

[resource]
script = ExtResource("1_data")
dialogue_id = &"ambush"
entries = Array[ExtResource("2_entry")]([SubResource("Entry1"), SubResource("Entry2"), SubResource("Entry3")])
