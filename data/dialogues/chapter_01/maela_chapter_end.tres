[sub_resource type="Resource" id="Entry1"]
script = ExtResource("2_entry")
text = "Volviste con una respuesta, aunque no sea la que queríamos escuchar. La expansión es real."

[sub_resource type="Resource" id="Entry2"]
script = ExtResource("2_entry")
text = "Tu decisión en el consejo marcará cómo se prepara el refugio. Desde hoy ya no sos solamente un recolector, {player_name}."

[resource]
